ANTHROPIC_API_KEY=
FAL_KEY=
# Optional: a *separate* fal.ai key with Admin/billing scope (not the same as
# FAL_KEY above). Generate one in the fal.ai dashboard under API Keys with the
# "Admin" permission. Without it, the admin panel shows a "check dashboard"
# link instead of a live balance for fal.ai.
FAL_ADMIN_KEY=
PORT=4000

# Single super-admin login for the /admin balances panel.
ADMIN_USERNAME=
# Use a bcrypt hash, not a plaintext password — generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
